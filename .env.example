# ────────────────────────────────────────────────────────────────────────────
# Large model — the agent orchestrator (PydanticAI). Pick ONE backend.
# Lettering matches ONBOARDING.md's Option A/B/C/D.
# ────────────────────────────────────────────────────────────────────────────

# --- Option A: Anthropic Claude (simplest, no local GPU) ---
# LARGE_MODEL__TYPE=anthropic
# LARGE_MODEL__NAME=claude-opus-4-7
# LARGE_MODEL__KEY=your-anthropic-key

# --- Option B: Azure OpenAI ---
LARGE_MODEL__TYPE=openai
LARGE_MODEL__NAME=gpt-5.5
LARGE_MODEL__URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>?api-version=2025-01-01-preview
LARGE_MODEL__KEY=your-azure-key

# --- Option C: Local Ollama (free, modest hardware) ---
# LARGE_MODEL__TYPE=vllm
# LARGE_MODEL__NAME=llama3.1:8b
# LARGE_MODEL__URL=http://localhost:11434/v1

# --- Option D: Self-hosted vLLM (production setup) ---
# Deploy via agent_orchestration_deployments/ then point at the vLLM endpoint.
# LARGE_MODEL__TYPE=vllm
# LARGE_MODEL__NAME=Hermes-4-70B
# LARGE_MODEL__URL=http://<gpu-host>:8082/v1
# LARGE_MODEL__KEY=                       # optional; vLLM doesn't require auth

# ────────────────────────────────────────────────────────────────────────────
# Small model (used by the RAG and jobpred sub-agents). Must be an
# OpenAI-compatible endpoint (openai/vllm) — 'anthropic' isn't supported
# here, only for LARGE_MODEL above.
# ────────────────────────────────────────────────────────────────────────────
# SMALL_MODEL__TYPE=vllm
# SMALL_MODEL__NAME=meta-llama/Meta-Llama-3.1-8B-Instruct
# SMALL_MODEL__URL=http://localhost:8000/v1

SMALL_MODEL__TYPE=openai
SMALL_MODEL__NAME=gpt-4o
SMALL_MODEL__URL=https://<your-resource>.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview
SMALL_MODEL__KEY=your-key

# ────────────────────────────────────────────────────────────────────────────
# SQL model (used by the SQL sub-agent). Same OpenAI-compatible-only
# constraint as SMALL_MODEL above.
# ────────────────────────────────────────────────────────────────────────────
# SQL_MODEL__TYPE=vllm
# SQL_MODEL__NAME=defog/llama-3-sqlcoder-8b
# SQL_MODEL__URL=http://localhost:8001/v1

SQL_MODEL__TYPE=openai
SQL_MODEL__NAME=gpt-4o
SQL_MODEL__URL=https://<your-resource>.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview
SQL_MODEL__KEY=your-key

# ────────────────────────────────────────────────────────────────────────────
# Tool enable/disable — remove a name to disable that sub-agent globally
# ────────────────────────────────────────────────────────────────────────────
ENABLED_TOOLS='["sql", "rag", "jobpred"]'

# ────────────────────────────────────────────────────────────────────────────
# Database / data paths / GPUs
# ────────────────────────────────────────────────────────────────────────────
DB_MODULE=src.site.ornl.frontier.db
CUDA_VISIBLE_DEVICES=0
DATA_BASE=.data/shared
DATA_PRIV_BASE=.data/private

# ────────────────────────────────────────────────────────────────────────────
# Syslog subsystem — causal-edges CSV and event-taxonomy doc. Both have
# repo-relative defaults (see src/syslog/causal.py / actions.py); set these
# only to point at a different file. Generate the default causal CSV with
# scripts/build_placeholder_causal_edges.py (see ONBOARDING.md step 7).
# ────────────────────────────────────────────────────────────────────────────
# HERALD_CAUSAL_CSV=.data/causal_edges_placeholder.csv
# HERALD_EVENT_TAXONOMY=src/syslog/event_taxonomy.md

# ────────────────────────────────────────────────────────────────────────────
# Frontend → backend (used by frontend/next.config.ts during `npm run dev`)
# ────────────────────────────────────────────────────────────────────────────
HERALD_API_URL=http://localhost:8000

# ────────────────────────────────────────────────────────────────────────────
# Docker boot (deploy/backend-entrypoint.sh): if RAG indexing can't reach
# HuggingFace (network/TLS issue — see deploy/README.md), the backend logs a
# warning and boots anyway; RAG search just won't work. Set this to skip the
# attempt entirely instead of waiting for it to fail on every restart.
# ────────────────────────────────────────────────────────────────────────────
# SKIP_RAG_INDEX=1
